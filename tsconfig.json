{
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }],
  "compilerOptions": {
    // Mirrors tsconfig.app.json so tooling that only reads the root
    // tsconfig (e.g. the shadcn CLI) resolves the "@" alias correctly.
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  }
}
